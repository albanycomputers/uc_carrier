<?php
/**
 * @file
 * Packaging stock for Carrier Rates.
 *
 * Quotes use the smallest packaging that holds the order, or split it across
 * several; the shipment form records what was really used and takes it off
 * stock; low stock is flagged. Packaging marked "Estimated" is whatever is to
 * hand: it has a typical size and weight and its stock is not counted.
 *
 * Weights are in grams and dimensions in millimetres.
 */

/**
 * Implements hook_config_info().
 */
function uc_carrier_packaging_config_info() {
  $prefixes['uc_carrier_packaging.settings'] = array(
    'label' => t('Ubercart carrier packaging settings'),
    'group' => t('Configuration'),
  );

  return $prefixes;
}

/**
 * Implements hook_menu().
 */
