<?php
/**
 * @file
 * Shipping quotes from carrier price lists, with tracking links.
 *
 * Carriers (Royal Mail, Parcelforce, DPD...) are defined by submodules through
 * hook_uc_carrier_info(). This module turns each one into an Ubercart shipping
 * method, works out the parcel (weight and size format), the destination zone
 * and the price from an imported price list, and links tracking numbers.
 *
 * Weights are in grams and dimensions in millimetres throughout.
 */

/**
 * Implements hook_config_info().
 */
function uc_carrier_config_info() {
  $prefixes['uc_carrier.settings'] = array(
    'label' => t('Ubercart carrier rates settings'),
    'group' => t('Configuration'),
  );

  return $prefixes;
}

/**
 * Implements hook_permission().
 */
function uc_carrier_permission() {
  return array(
    'administer carrier rates' => array(
      'title' => t('Administer carrier rates'),
      'description' => t('Configure carriers, zones and price lists.'),
      'restrict access' => TRUE,
    ),
  );
}

